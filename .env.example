# Google Drive (optional; see docs/google-drive.md). Public browser configuration only:
# never put a client secret here. Leave any value empty to build without Drive.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# Google Analytics 4 (optional; ADR 0014). The public measurement ID, such as G-ABC123XYZ9.
# Production builds only (never `npm run dev`); users are asked before anything is sent.
# Leave empty to build without usage statistics.
VITE_GA_MEASUREMENT_ID=
