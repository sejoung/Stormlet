    {
      "id": "intro",
      "objectType": "text",
      "width": 720,
      "text": "1. Each person keeps one colour  2. Write Keep / Problem / Try  3. Group themes  4. Agree actions"
    },
    { "id": "k1", "frame": "keep", "color": "yellow", "text": "Mina\nSmall releases brought fast feedback" },
    { "id": "k2", "frame": "keep", "color": "sky", "text": "Jun\nPairing helped me get unstuck" },
    { "id": "k3", "frame": "keep", "color": "pink", "text": "Sera\nShort demos showed our progress" },
    { "id": "p1", "frame": "problem", "color": "yellow", "text": "Mina\nLate reviews blocked my next task" },
    { "id": "p2", "frame": "problem", "color": "sky", "text": "Jun\nI sometimes missed review requests" },
    { "id": "p3", "frame": "problem", "color": "pink", "text": "Sera\nI heard about requirement changes late" },
    { "id": "t1", "frame": "try", "color": "yellow", "text": "Mina\nReserve a daily review time" },
    { "id": "t2", "frame": "try", "color": "sky", "text": "Jun\nPut urgent review requests in one channel" },
    { "id": "t3", "frame": "try", "color": "pink", "text": "Sera\nReview changes together each Monday" },
    {
      "id": "a1",
      "frame": "actions",
      "color": "green",
      "width": 240,
      "text": "Check the review channel daily at 16:00\nOwner: Jun · From next Monday"
    },
    {
      "id": "a2",
      "frame": "actions",
      "color": "green",
      "width": 240,
      "text": "Review requirement changes in Monday planning\nOwner: Sera · From next sprint"
    }
