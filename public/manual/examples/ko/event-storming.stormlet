{
  "format": "stormlet",
  "version": 13,
  "title": "이벤트 스토밍 · 주문 흐름",
  "frames": [
    {
      "id": "notation",
      "title": "이벤트 스토밍 범례",
      "role": "legend",
      "layout": "row",
      "spacing": {
        "gap": 32,
        "padding": 40
      }
    },
    {
      "id": "order",
      "title": "주문",
      "layout": "flow"
    },
    {
      "id": "payment",
      "title": "결제",
      "layout": "flow"
    },
    {
      "id": "shipping",
      "title": "배송",
      "layout": "flow"
    }
  ],
  "stickies": [
    {
      "id": "key-event",
      "frame": "notation",
      "text": "이벤트",
      "color": "orange",
      "width": 220,
      "height": 120,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "key-command",
      "frame": "notation",
      "text": "명령",
      "color": "blue",
      "width": 220,
      "height": 120,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "key-actor",
      "frame": "notation",
      "text": "액터",
      "color": "yellow",
      "width": 220,
      "height": 120,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "key-policy",
      "frame": "notation",
      "text": "정책",
      "color": "purple",
      "width": 220,
      "height": 120,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "key-aggregate",
      "frame": "notation",
      "text": "애그리게이트",
      "color": "gold",
      "width": 220,
      "height": 120,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "key-read",
      "frame": "notation",
      "text": "조회 모델",
      "color": "green",
      "width": 220,
      "height": 120,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "key-external",
      "frame": "notation",
      "text": "외부 시스템",
      "color": "pink",
      "width": 220,
      "height": 120,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "key-hotspot",
      "frame": "notation",
      "text": "확인 사항",
      "color": "red",
      "width": 220,
      "height": 120,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "o-actor",
      "frame": "order",
      "color": "yellow",
      "text": "고객",
      "width": 220,
      "height": 160,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "o-cmd",
      "frame": "order",
      "color": "blue",
      "text": "주문하기",
      "width": 220,
      "height": 160,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "o-agg",
      "frame": "order",
      "color": "gold",
      "text": "주문",
      "width": 220,
      "height": 160,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "o-evt",
      "frame": "order",
      "color": "orange",
      "text": "주문이 접수되었다",
      "width": 220,
      "height": 160,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "o-hot",
      "frame": "order",
      "color": "red",
      "text": "재고가 없으면 어떻게 할까?",
      "width": 220,
      "height": 160,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "p-policy",
      "frame": "payment",
      "color": "purple",
      "text": "주문이 접수되면\n결제를 요청한다",
      "width": 220,
      "height": 160,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "p-ext",
      "frame": "payment",
      "color": "pink",
      "text": "결제 제공자",
      "width": 220,
      "height": 160,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "p-evt",
      "frame": "payment",
      "color": "orange",
      "text": "결제가 승인되었다",
      "width": 220,
      "height": 160,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "p-hot",
      "frame": "payment",
      "color": "red",
      "text": "결제 실패 후 재시도는?",
      "width": 220,
      "height": 160,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "s-policy",
      "frame": "shipping",
      "color": "purple",
      "text": "결제가 승인되면\n배송을 준비한다",
      "width": 220,
      "height": 160,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "s-read",
      "frame": "shipping",
      "color": "green",
      "text": "포장 목록",
      "width": 220,
      "height": 160,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "s-evt",
      "frame": "shipping",
      "color": "orange",
      "text": "배송이 시작되었다",
      "width": 220,
      "height": 160,
      "fontSize": 20,
      "autoFont": false
    },
    {
      "id": "s-hot",
      "frame": "shipping",
      "color": "red",
      "text": "취소는 언제까지 가능할까?",
      "width": 220,
      "height": 160,
      "fontSize": 20,
      "autoFont": false
    }
  ],
  "connections": [
    {
      "from": "o-actor",
      "to": "o-cmd"
    },
    {
      "from": "o-cmd",
      "to": "o-agg"
    },
    {
      "from": "o-agg",
      "to": "o-evt"
    },
    {
      "from": "o-evt",
      "to": "p-policy"
    },
    {
      "from": "p-policy",
      "to": "p-ext"
    },
    {
      "from": "p-ext",
      "to": "p-evt"
    },
    {
      "from": "p-evt",
      "to": "s-policy"
    },
    {
      "from": "s-policy",
      "to": "s-read"
    },
    {
      "from": "s-read",
      "to": "s-evt"
    }
  ],
  "layout": "flow",
  "spacing": {
    "gap": 80,
    "rankGap": 180,
    "crossGap": 100,
    "padding": 60
  }
}
